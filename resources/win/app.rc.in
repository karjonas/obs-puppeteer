// Configured by CMake. The icon path is absolute because the generated file
// lives in the build directory.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/obs-puppeteer.ico"

// VS_VERSION_INFO, spelled numerically to avoid Windows headers.
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OBS Puppeteer contributors"
            VALUE "FileDescription", "Unofficial control panel for OBS Studio"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "obs-puppeteer"
            VALUE "LegalCopyright", "Licensed GPL-3.0-or-later. Not affiliated with the OBS Project."
            VALUE "OriginalFilename", "obs-puppeteer.exe"
            VALUE "ProductName", "OBS Puppeteer"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
